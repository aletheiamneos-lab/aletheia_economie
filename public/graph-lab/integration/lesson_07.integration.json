        "title": "Venit total, cost total și pragul de rentabilitate",
        "kind": "break_even",
        "status": "B",
        "formulas": [
          "VT = P × Q",
          "CT = CF + CV",
          "Prag: VT = CT sau P = CMT"
        ]
      },
      {
        "id": "profit_total",
        "title": "Profit total în funcție de producție",
        "kind": "profit_curve",
        "status": "B",
        "formulas": [
          "Pr.T = VT - CT"
        ]
      },
      {
        "id": "profit_unitar",
        "title": "Profitul unitar și profitul total",
        "kind": "profit_unit",
        "status": "B",
        "formulas": [
          "Pr.u = P - CMT",
          "Pr.T = Pr.u × Q"
        ]
      },
      {
        "id": "profit_marginal",
        "title": "Profitul marginal și nivelul optim",
        "kind": "marginal_profit",
        "status": "B",
        "formulas": [
          "Pr.mg = Vmg - Cmg",
          "Optim: Vmg = Cmg"
        ]
      },
      {
        "id": "rate_profit",
        "title": "Ratele profitului",
        "kind": "profit_rates",
        "status": "B",
        "formulas": [
          "RPr(CT)=Pr/CT×100",
          "RPr(KT)=Pr/KT×100",
          "RPr(CA)=Pr/CA×100"
        ]
      },
      {
        "id": "forme_profit",
        "title": "Profit brut, net, normal și economic",
        "kind": "profit_forms",
        "status": "B",
        "formulas": [
          "Pr.brut = CA - CT",
          "Pr.net = Pr.brut - impozit",
          "Pr.economic = Pr.net - Pr.normal"
        ]
      },
      {
        "id": "renta_diferentiala",
        "title": "Renta funciară diferențiată",
        "kind": "rent_differential",
        "status": "B",
        "formulas": [
          "CMTi = CT / Qi",
          "Piața este raportată la terenul marginal",
          "Renta_i = (P - CMT_i) × Q_i"
        ]
      }
    ]
  },
