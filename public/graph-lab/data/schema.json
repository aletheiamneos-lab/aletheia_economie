{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Economics Graph Lesson Config",
  "type": "object",
  "required": [
    "lesson",
    "title",
    "modules"
  ],
  "properties": {
    "lesson": {
      "type": "integer",
      "minimum": 1,
      "maximum": 19
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "defaults"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "defaults": {
            "type": "object"
          },
          "formulas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "labels": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}